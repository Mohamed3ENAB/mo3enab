# قاعدة البيانات — أي PostgreSQL. من Supabase: Settings → Database → Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# كلمة سر لوحة الإدارة. غيّرها لحاجة قوية.
ADMIN_PASSWORD=change-me

# سر لتوقيع كوكي الدخول. ولّده بـ: openssl rand -hex 32
SESSION_SECRET=change-me-too

# رقم الدعم اللي بيظهر في الصفحة
NEXT_PUBLIC_SUPPORT_PHONE=01000000000
